NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=InsolvencyVDR
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloud Import — Google Drive
# Get these from Google Cloud Console → APIs & Services → Credentials
# OAuth 2.0 Client ID (Web application type) and an API key restricted to Picker API
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_DRIVE_API_KEY=

# Cloud Import — Microsoft OneDrive
# Get this from Microsoft Entra ID → App registrations → Application (client) ID
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
