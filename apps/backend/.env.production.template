# ============================================================================
# VariedReach VDR — Production Environment Configuration Template
# Phase 3C.3 deliverable. Prepared on staging; NEVER applied to production
# by this phase, and never populated with production secrets by this phase.
#
# How to use this file:
#   1. Copy it to the production host as apps/backend/.env (do NOT commit
#      the populated copy — this template stays in git; the real one never
#      does, per .gitignore).
#   2. Replace every <PLACEHOLDER> below with a real, production-specific
#      value. Never copy a value from staging's own .env — see the
#      per-section notes on exactly which values must differ.
#   3. Run `node_modules/.bin/prisma db push` (or the project's established
#      migration process at the time) against the production database.
#   4. Boot the backend once with CLAUDE_API_ENABLED=false (the default
#      below) to confirm validate-production-env.ts passes before ever
#      touching the Claude-specific variables — see
#      ANTHROPIC_ACTIVATION_RUNBOOK.md for that separate, later step.
# ============================================================================

# ---- Server ----
NODE_ENV=production
PORT=4000
APP_URL=https://<PRODUCTION_API_HOST>
FRONTEND_URL=https://<PRODUCTION_FRONTEND_HOST>
# Deliberately absent/unset here -- APP_ENVIRONMENT=staging is what grants
# staging's Claude-provider-isolation and Razorpay-mock exemptions in
# validate-production-env.ts and claude.config.ts. Never set this to
# "staging" on a real production host, and never set it to anything at all
# unless a future environment tier genuinely needs its own exemption.
APP_ENVIRONMENT=

# ---- Database ----
# Must be this deployment's own, real production database -- never
# staging's insolvency_vdr_staging, never a copy of staging's connection
# string. A fresh production deployment's user/password/db name are
# provisioned once, specifically for this purpose, not reused from anywhere.
DATABASE_URL=postgresql://<PROD_DB_USER>:<PROD_DB_PASSWORD>@<PROD_DB_HOST>:5432/<PROD_DB_NAME>?schema=public

# ---- Redis ----
REDIS_URL=redis://<PROD_REDIS_HOST>:6379

# ---- Cookies / JWT ----
# validate-production-env.ts refuses to boot if either of these is missing,
# a known dev placeholder, or under 32 characters. Generate real, unique
# random values for this deployment (e.g. `openssl rand -base64 48`) --
# never reuse staging's secrets, and never reuse a value across two
# different production deployments either.
COOKIE_SECRET=<GENERATE_A_REAL_RANDOM_SECRET_32_CHARS_MINIMUM>
JWT_ACCESS_SECRET=<GENERATE_A_REAL_RANDOM_SECRET_32_CHARS_MINIMUM>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
JWT_REFRESH_REMEMBER_ME_EXPIRES_DAYS=30
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=30
MAX_CONCURRENT_SESSIONS=3
PASSWORD_RESET_EXPIRES_MINUTES=60
INVITE_EXPIRES_HOURS=72
REGISTRATION_VERIFICATION_EXPIRES_HOURS=24
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=30

# ---- Rate limiting ----
THROTTLE_TTL=900000
THROTTLE_LIMIT=1000
THROTTLE_AUTH_LIMIT=20

# ---- Mail (production uses the real Resend account — this is the ONE
# credential this template explicitly expects to be shared with staging's
# OWN separate copy of the real key, since Resend's API key is account-
# wide, not environment-specific; everything else below must still be this
# deployment's own value, not copied from anywhere) ----
MAIL_PROVIDER=resend
RESEND_API_KEY=<PRODUCTION_RESEND_API_KEY>
RESEND_WEBHOOK_SECRET=<FROM_RESEND_DASHBOARD_WEBHOOK_CONFIG>
MAIL_FROM_NAME=Varied Reach
MAIL_FROM_ADDRESS=<A_VERIFIED_SENDING_ADDRESS_ON_THE_PRODUCTION_DOMAIN>
CONTACT_NOTIFICATIONS_EMAIL=<REAL_SALES_INBOX>

# ---- Storage thresholds ----
STORAGE_WARNING_PERCENT=80
STORAGE_CRITICAL_PERCENT=95
STORAGE_LOCAL_PATH=./uploads
STORAGE_MAX_FILE_SIZE_BYTES=2147483648

# ---- Payments (production MUST use razorpay -- validate-production-env.ts
# fails the boot otherwise, since APP_ENVIRONMENT=staging's exemption only
# applies to staging). Use this deployment's real, live Razorpay credentials
# -- never staging's invalid placeholder, never a test-mode key.
# Configure the matching webhook in the Razorpay dashboard pointing at
# https://<PRODUCTION_API_HOST>/api/v1/webhooks/razorpay for the
# payment.captured, payment.failed, and refund.processed events before
# accepting any real customer payment. ----
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=<PRODUCTION_LIVE_KEY_ID>
RAZORPAY_KEY_SECRET=<PRODUCTION_LIVE_KEY_SECRET>
RAZORPAY_WEBHOOK_SECRET=<FROM_RAZORPAY_DASHBOARD_WEBHOOK_CONFIG>

# ---- Office document conversion ----
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_TIMEOUT_MS=30000

# ---- Bootstrap admin (prisma db seed, first IPO client's own organisation
# -- see CUSTOMER_ONBOARDING_SOP.md for the full procedure this feeds into).
# Change the seeded password immediately after first login regardless. ----
SEED_ORG_NAME=<CUSTOMER_ORGANISATION_LEGAL_NAME>
SEED_ORG_SLUG=<CUSTOMER_ORG_SLUG>
SEED_ADMIN_EMAIL=<CUSTOMER_ADMIN_EMAIL>
SEED_ADMIN_PASSWORD=<GENERATE_A_REAL_TEMPORARY_PASSWORD_NOT_ChangeMe123>

# ============================================================================
# Anthropic Claude API — stays fully disabled until ANTHROPIC_ACTIVATION_
# RUNBOOK.md has genuinely been followed for a real, approved customer.
# Do NOT populate ANTHROPIC_API_KEY or flip CLAUDE_PRODUCTION_ACTIVATION_
# APPROVED to true as part of initial deployment -- this is a deliberate,
# separate, later step with its own sign-off, never bundled with go-live.
# ============================================================================
CLAUDE_API_ENABLED=false
ANTHROPIC_API_KEY=
CLAUDE_PRODUCTION_ACTIVATION_APPROVED=false
CLAUDE_SUMMARY_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TOKENS=4096
CLAUDE_MAX_INPUT_TOKENS=150000
CLAUDE_REQUEST_TIMEOUT=60000
CLAUDE_MAX_RETRIES=2
CLAUDE_MAX_PAGES_PER_ANALYSIS=100
# If CLAUDE_SUMMARY_MODEL is ever changed, these two prices must be updated
# to match Anthropic's current published rate for that model, or cost
# estimates and budget enforcement will silently use the wrong number.
CLAUDE_INPUT_PRICE_PER_MTOK_USD=2.00
CLAUDE_OUTPUT_PRICE_PER_MTOK_USD=10.00

# ---- Local OCR (Ghostscript + Tesseract) -- no spend gate, safe to run
# enabled from day one regardless of Claude's own activation status. ----
OCR_ENABLED=true
OCR_LANGUAGES=eng+hin
OCR_DPI=150
OCR_MAX_PAGES_PER_DOCUMENT=50
OCR_TIMEOUT_MS=20000
OCR_LOW_CONFIDENCE_THRESHOLD=70

# ---- AI spending guardrails. These four values are checked before every
# Claude call once activated -- NEVER copy the $2.00 figure used for the
# staging pilot, and never leave the historical $100 suggested-default in
# place for a real paying customer without a deliberate decision. Set these
# to the ACTUAL approved spending budget from ANTHROPIC_ACTIVATION_
# RUNBOOK.md's own sign-off step, specific to this customer/deployment.
#
# Known naming quirk, not yet renamed (tracked in the Outstanding Risks
# register): AI_MAX_GLOBAL_STAGING_COST_USD is genuinely the all-time
# ceiling for WHICHEVER deployment reads it, production included -- the
# "STAGING" in its name is a holdover from when this guardrail was built,
# not a sign it's staging-only. ----
AI_MAX_COST_PER_DOCUMENT_USD=<SET_FROM_APPROVED_BUDGET>
AI_MAX_DAILY_ORG_COST_USD=<SET_FROM_APPROVED_BUDGET>
AI_MAX_MONTHLY_ORG_COST_USD=<SET_FROM_APPROVED_BUDGET>
AI_MAX_GLOBAL_STAGING_COST_USD=<SET_FROM_APPROVED_BUDGET>
AI_MAX_CONCURRENT_JOBS=2
