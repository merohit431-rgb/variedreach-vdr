# Server
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Database (matches docker-compose.yml postgres service)
DATABASE_URL=postgresql://vdr_user:vdr_password@localhost:5432/insolvency_vdr?schema=public

# Redis (sessions / rate limiting / queues — wired up in later modules)
REDIS_URL=redis://localhost:6379

# Cookies
COOKIE_SECRET=dev-cookie-secret-change-in-production

# Rate limiting
THROTTLE_TTL=900000
THROTTLE_LIMIT=1000
THROTTLE_AUTH_LIMIT=20

# JWT / sessions
JWT_ACCESS_SECRET=dev-access-secret-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
JWT_REFRESH_REMEMBER_ME_EXPIRES_DAYS=30
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=30
MAX_CONCURRENT_SESSIONS=3
PASSWORD_RESET_EXPIRES_MINUTES=60
INVITE_EXPIRES_HOURS=72
REGISTRATION_VERIFICATION_EXPIRES_HOURS=24

# Mail — two providers, selected by MAIL_PROVIDER:
#   nodemailer (default) — plain SMTP, points at MailHog in dev (see
#     docker-compose.yml). Uses MAIL_HOST/PORT/SECURE/USER/PASSWORD below.
#   resend — the real Resend API (staging/prod). Uses RESEND_API_KEY
#     instead of the MAIL_HOST/PORT/* block. MAIL_FROM_ADDRESS must be on a
#     domain verified in your Resend account — it will silently reject
#     sends from an unverified domain.
MAIL_PROVIDER=nodemailer
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=Varied Reach
MAIL_FROM_ADDRESS=noreply@insolvencyvdr.local
RESEND_API_KEY=
# From the Resend dashboard once a webhook endpoint is configured pointing
# at https://<host>/api/v1/webhooks/resend — used to verify delivered/
# bounced event signatures. Leave blank until that manual setup is done.
RESEND_WEBHOOK_SECRET=
# Sales inbox for marketing-site demo/callback form notifications.
# Defaults to rohit@variedreach.com when unset.
CONTACT_NOTIFICATIONS_EMAIL=
# Set to "staging" only on the staging environment — prefixes every email
# subject with "[STAGING] " so it's visually distinguishable from
# production even though both send from the same address.
APP_ENVIRONMENT=

# Storage-threshold warning emails (80%/95% of a data room's storage limit;
# 100%/"full" isn't separately configurable)
STORAGE_WARNING_PERCENT=80
STORAGE_CRITICAL_PERCENT=95

# File storage (local filesystem for V1.0)
STORAGE_LOCAL_PATH=./uploads
STORAGE_MAX_FILE_SIZE_BYTES=2147483648

# Payments — PAYMENT_PROVIDER selects which one registration/checkout uses:
#   mock (default) — no gateway call, always "succeeds"; safe for local/dev.
#   razorpay — real Razorpay orders. Requires the three RAZORPAY_* values
#     below and, for asynchronous confirmation (see webhooks.controller.ts
#     POST /webhooks/razorpay), a webhook configured in the Razorpay
#     dashboard pointing at https://<host>/api/v1/webhooks/razorpay with
#     the payment.captured, payment.failed, and refund.processed events.
# NEVER put a live key in this repo or a committed file — these are read
# from the real environment's .env only, which is gitignored.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Office document conversion (Word/Excel/PowerPoint -> PDF before preview/
# watermarking) — points at the gotenberg service in docker-compose.yml.
# Default already resolves correctly inside every Compose project (dev/
# staging/prod each get their own isolated network), so this normally
# doesn't need overriding.
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_TIMEOUT_MS=30000

# Bootstrap admin (prisma db seed) — change the password after first login
SEED_ORG_NAME=Demo Resolution Professionals LLP
SEED_ORG_SLUG=demo-rp
SEED_ADMIN_EMAIL=info@variedreach.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Phase 3C: Anthropic Claude-backed document analysis — CLAUDE_API_ENABLED
# stays "false" until a dedicated staging API key, an explicitly approved
# spending cap, and a small authorised pilot are all in place (see
# PHASE_3C_LIVE_PILOT_CHECKLIST.md). With it false, nothing here is ever
# read and no network call to Anthropic is ever made — the existing
# extractive (Mock) summary keeps working exactly as before.
# NEVER put a live key in this repo or a committed file.
#
# CLAUDE_SUMMARY_MODEL and the two price variables below are NOT
# cross-derived — if you change the model, update both prices to match
# Anthropic's current published rate for that model, or cost estimates and
# budget enforcement will silently use the wrong number.
CLAUDE_API_ENABLED=false
ANTHROPIC_API_KEY=
CLAUDE_SUMMARY_MODEL=claude-sonnet-5-5
CLAUDE_MAX_TOKENS=4096
CLAUDE_MAX_INPUT_TOKENS=150000
CLAUDE_REQUEST_TIMEOUT=60000
CLAUDE_MAX_RETRIES=2
CLAUDE_MAX_PAGES_PER_ANALYSIS=100
CLAUDE_INPUT_PRICE_PER_MTOK_USD=2.00
CLAUDE_OUTPUT_PRICE_PER_MTOK_USD=10.00

# Phase 3C: local OCR (Ghostscript + Tesseract) for scanned PDF pages.
# Defaults to enabled — this runs entirely locally with no external call
# and no spend-approval gate, unlike Claude above.
OCR_ENABLED=true
OCR_LANGUAGES=eng+hin
OCR_DPI=150
OCR_MAX_PAGES_PER_DOCUMENT=50
OCR_TIMEOUT_MS=20000
OCR_LOW_CONFIDENCE_THRESHOLD=70

# Phase 3C: AI spending guardrails, checked before every Claude call. These
# are conservative suggested starting points, NOT a pre-approved budget —
# changing them alone never enables real spending (see CLAUDE_API_ENABLED).
AI_MAX_COST_PER_DOCUMENT_USD=0.50
AI_MAX_DAILY_ORG_COST_USD=5.00
AI_MAX_MONTHLY_ORG_COST_USD=50.00
AI_MAX_GLOBAL_STAGING_COST_USD=100.00
AI_MAX_CONCURRENT_JOBS=2
