generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════

// 8 roles per the PRD permission matrix (section 2.1). Permissions cascade:
// higher roles inherit lower-role access unless explicitly restricted.
enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  RP_LIQUIDATOR
  PRA
  COC_MEMBER
  AUDITOR
  LEGAL_ADVISOR
  GUEST
}

// Note: there is no LOCKED status. Failed-login lockout is time-based
// (User.lockedUntil) and self-expires — it doesn't need a status of its own.
enum UserStatus {
  PENDING_INVITE
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum DataRoomType {
  CIRP
  LIQUIDATION
  MA_DUE_DILIGENCE
  IPO
  OTHER
}

enum DataRoomStatus {
  ACTIVE
  ARCHIVED
  SUSPENDED
}

// Lean V1.0 action set. Postgres enums can have values appended later
// without breaking existing rows.
enum AuditAction {
  USER_LOGGED_IN
  USER_LOGGED_OUT
  USER_LOGIN_FAILED
  USER_ACCOUNT_LOCKED
  USER_PASSWORD_RESET_REQUESTED
  USER_PASSWORD_RESET_COMPLETED
  USER_INVITED
  USER_INVITE_ACCEPTED
  USER_ROLE_CHANGED
  USER_SUSPENDED
  USER_REACTIVATED
  USER_REMOVED
  DATA_ROOM_CREATED
  DATA_ROOM_UPDATED
  DATA_ROOM_DELETED
  FOLDER_CREATED
  FOLDER_COPIED
  FOLDER_RENAMED
  FOLDER_MOVED
  FOLDER_DELETED
  FILE_UPLOADED
  FILE_VERSION_UPLOADED
  FILE_VIEWED
  FILE_DOWNLOADED
  FILE_RENAMED
  FILE_MOVED
  FILE_DELETED
  REPORT_EXPORTED
  NDA_ACCEPTED
  QUESTION_ASKED
  QUESTION_ANSWERED
  QUESTION_STATUS_CHANGED
  QUESTION_ANSWER_EDITED
  QUESTION_DELETED
  BULK_DOWNLOADED
  ORIGINAL_FILE_DOWNLOADED
  ORIGINAL_FILE_DOWNLOAD_DENIED
  FOLDER_ACCESS_GRANTED
  FOLDER_ACCESS_REVOKED
  FOLDER_ACCESS_DENIED
  DATA_ROOM_FOLDER_RESTRICTION_TOGGLED
  GROUP_CREATED
  GROUP_UPDATED
  GROUP_MEMBER_ADDED
  GROUP_MEMBER_REMOVED
  DATA_ROOM_TEMPLATE_APPLIED
  DOWNLOAD_ORIGINAL_PERMISSION_CHANGED
  MFA_ENABLED
  MFA_DISABLED
  STORAGE_UPGRADE_REQUESTED
  SESSION_REVOKED
  TRUSTED_DEVICE_ADDED
  TRUSTED_DEVICE_REVOKED
  MFA_OTP_GENERATED
  MFA_OTP_FAILED
  LOGIN_BLOCKED
  // Phase 3B.2: distinct from USER_SUSPENDED (the admin action of
  // suspending someone) -- this is the suspended account's OWN attempt
  // being denied. One action, not three, covers login/refresh/existing-
  // session denial; metadata.stage distinguishes which, same convention as
  // DOCUMENT_ANALYSIS_REQUESTED's metadata.isRegeneration.
  LOGIN_DENIED_SUSPENDED
  PAYMENT_CAPTURED
  PAYMENT_FAILED
  PAYMENT_REFUND_INITIATED
  PAYMENT_REFUNDED
  ORGANISATION_UPDATED
  COUPON_CREATED
  COUPON_UPDATED
  COUPON_DELETED
  BUSINESS_PROFILE_UPDATED
  ORGANISATION_RENAMED
  ORGANISATION_ACTIVATED
  ORGANISATION_DEACTIVATED
  ORGANISATION_DELETED
  SUBSCRIPTION_DATES_UPDATED
  SUBSCRIPTION_REACTIVATED
  DOCUMENT_ANALYSIS_REQUESTED
  DOCUMENT_ANALYSIS_COMPLETED
  DOCUMENT_ANALYSIS_FAILED
  DOCUMENT_ANALYSIS_CANCELLED
  DOCUMENT_ANALYSIS_VIEWED
  DOCUMENT_ANALYSIS_RETRIED
  DOCUMENT_ANALYSIS_ACCESS_DENIED
  // Phase 3C: only 4 new values, not a parallel AI_SUMMARY_* lifecycle --
  // Claude synthesis is layered onto the same DocumentAnalysis row/request/
  // view/retry/cancel lifecycle the 7 actions above already audit. These
  // are the genuinely new lifecycle points that have no existing
  // equivalent: local OCR (its own sub-pipeline, not covered by any action
  // above) and a budget guard blocking a paid call before it's made.
  AI_OCR_STARTED
  AI_OCR_COMPLETED
  AI_OCR_FAILED
  AI_BUDGET_LIMIT_REACHED
}

enum PermissionScope {
  DATA_ROOM
  FOLDER
  FILE
}

enum PermissionPrincipal {
  USER
  ROLE
}

// ═══════════════════════════════════════════════════════════
// ORGANISATION (tenant) & USERS
// ═══════════════════════════════════════════════════════════

model Organisation {
  id             String             @id @default(uuid())
  name           String
  slug           String             @unique
  logoUrl        String?
  // The actual enforced/displayed total -- always plan.minimumStorageGb +
  // storageAddOnGb, recomputed by updateOrganisation() whenever either
  // input changes. Never edited directly so a plan change can't silently
  // wipe out a purchased add-on, and an add-on purchase can't drift out of
  // sync with a later plan change.
  storageLimitGb Int                @default(25)
  // Purchased on top of the plan's base allocation -- tracked separately
  // specifically so changing planSlug recomputes storageLimitGb from the
  // new plan's base + this, rather than overwriting a customer's add-on.
  storageAddOnGb Int                @default(0)
  // SaaS plan limits — null for legacy/manually-provisioned orgs
  planSlug       String?
  userLimit      Int                @default(10)
  gstNumber      String?
  address        String?
  mobileNumber   String?
  // Super Admin manual activate/deactivate -- independent of subscription
  // status (a SUSPENDED org blocks access immediately regardless of what
  // its subscription says; a subscription lapsing is a separate, later
  // path to the same effective lockout, not the same field).
  status         OrganisationStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  // Soft-delete/archive -- deliberately the only deletion path exposed by
  // the product (see super-admin.service.ts archiveOrganisation()). Every
  // relation below is onDelete: Cascade, so a real hard-delete of this row
  // would be immediate and unrecoverable across memberships, data rooms
  // and everything under them, subscriptions, payments, and invoices --
  // status quo before this field existed was that deletedAt was already
  // present on this model but read nowhere, i.e. fully decorative.
  deletedAt      DateTime?

  users        User[]
  dataRooms    DataRoom[]
  subscription Subscription?
  payments     Payment[]
  invoices     Invoice[]
  memberships  OrganisationMembership[]
  groups       Group[]

  @@map("organisations")
}

enum OrganisationStatus {
  ACTIVE
  SUSPENDED
}

// A User is a global identity; membership (with a role scoped to that
// membership) is a separate relationship, so one email can belong to
// multiple organisations with a different role in each — e.g. a PRA on
// one engagement and an Auditor on another. User.organisationId/role
// remain as a legacy default (kept for backward compat, no longer read
// by authorization logic — see JwtStrategy) rather than the source of
// truth once a membership exists for that user.
model OrganisationMembership {
  id             String           @id @default(uuid())
  userId         String
  organisationId String
  role           UserRole
  // The membership created when this org was purchased/provisioned, as
  // opposed to one granted via a later data-room member invite.
  isOwner        Boolean          @default(false)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
  @@index([userId])
  @@index([organisationId])
  @@map("organisation_memberships")
}

model User {
  id                  String     @id @default(uuid())
  organisationId      String
  email               String     @unique
  password            String
  firstName           String
  lastName            String
  // Enterprise profile fields, captured at invite time (see InviteMemberDto)
  // and shown on the member profile view. Person-level, not per-data-room.
  company             String?
  designation         String?
  mobile              String?
  role                UserRole
  status              UserStatus @default(PENDING_INVITE)
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  // bcrypt hashes of the last 5 passwords, oldest first — enforces no-reuse policy
  previousPasswords   Json       @default("[]")
  // TOTP-based MFA — secret stored as base32 string. Scaffolded but not
  // exposed in any UI; superseded by email OTP below (see MANDATORY_MFA_ROLES).
  totpSecret          String?
  totpEnabled         Boolean    @default(false)
  // Email-OTP 2FA — self-service opt-in for roles where it isn't mandatory
  // (see MANDATORY_MFA_ROLES in auth/constants/mfa.constants.ts).
  emailOtpEnabled     Boolean    @default(false)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  organisation              Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  organisationMemberships   OrganisationMembership[]
  dataRoomMemberships       DataRoomMember[]
  folderAccessGrants        FolderAccessGrant[]
  groupMemberships          GroupMember[]
  sessions                  Session[]
  emailOtpChallenges        EmailOtpChallenge[]
  trustedDevices            TrustedDevice[]
  inviteToken               InviteToken?
  passwordResetTokens       PasswordResetToken[]
  auditLogs                 AuditLog[]
  uploadedFiles             File[]                   @relation("FileUploader")
  uploadedVersions          FileVersion[]            @relation("FileVersionUploader")
  watermarkEvents           Watermark[]
  emailLogs                 EmailLog[]
  ndaAcceptances            NdaAcceptance[]
  questionsAsked            Question[]               @relation("QuestionAsker")
  answersGiven              Answer[]                 @relation("AnswerAuthor")
  notifications             Notification[]
  documentAnalysesRequested DocumentAnalysis[]

  @@index([organisationId])
  @@map("users")
}

// Single-use, time-limited invite link (72-hour expiry per PRD 3.1.1).
// tokenHash stores SHA-256 of the raw token; the raw token only ever
// appears in the emailed URL, never persisted.
model InviteToken {
  id         String    @id @default(uuid())
  userId     String    @unique
  tokenHash  String    @unique
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("invite_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

// Pre-payment self-service signup. Deliberately NOT a User/Organisation --
// per the V2.0 funnel, the real Organisation+User only get created once
// payment succeeds (a later phase). One row per registrant; unlike User
// (which accumulates invite/reset tokens over a long lifetime), a
// Registration is short-lived and only ever needs one active verification
// token, so a resend just overwrites the hash/expiry in place.
model Registration {
  id                    String    @id @default(uuid())
  fullName              String
  companyName           String
  email                 String    @unique
  mobileNumber          String
  passwordHash          String
  gstNumber             String?
  companyAddress        String?
  selectedPlan          String
  selectedStorageGb     Int
  billingCycle          String    @default("MONTHLY")
  verificationTokenHash String?   @unique
  verificationExpiresAt DateTime?
  verifiedAt            DateTime?
  // Set when a payment order is created
  gatewayOrderId        String?   @unique
  // Set to 'COMPLETED' after successful provisioning
  paymentStatus         String?
  // Set after Org + User are created — idempotency guard
  provisionedAt         DateTime?
  // Coupon captured + resolved at create-order time, applied at provisioning
  // so the gateway charge and the invoice both reflect the discount.
  couponCode            String?
  discountPaisa         Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("registrations")
}

// Refresh-token session record. Enables concurrent-session limiting (PRD:
// max 3 by default) and remote revocation. tokenHash, never the raw token.
model Session {
  id             String    @id @default(uuid())
  userId         String
  // Which organisation this session/refresh-token is currently scoped to --
  // null for SUPER_ADMIN (org-agnostic) and, transiently, for a session
  // that hasn't completed workspace selection yet.
  organisationId String?
  tokenHash      String    @unique
  userAgent      String?
  ipAddress      String?
  // Best-effort "City, Country" from a one-time IP geolocation lookup at
  // login (see common/utils/geo-ip.util.ts) -- null if the lookup timed out
  // or the service was unreachable; never blocks or slows down login itself.
  location       String?
  rememberMe     Boolean   @default(false)
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  // Bumped on refresh() (~ every access-token lifetime of continued use) as
  // a low-overhead "still active" signal -- not touched on every request.
  lastActiveAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("sessions")
}

// One row per login OTP sent — codeHash only, like every other token in this
// schema (PasswordResetToken, InviteToken). A fresh challenge supersedes any
// prior unconsumed one for the same user (created on login and on resend).
model EmailOtpChallenge {
  id             String    @id @default(uuid())
  userId         String
  codeHash       String
  attempts       Int       @default(0)
  rememberMe     Boolean   @default(false)
  ipAddress      String?
  userAgent      String?
  expiresAt      DateTime
  consumedAt     DateTime?
  // Set when the mail provider itself reported failure to send this code --
  // lets resend skip the cooldown for a delivery that never went out, so a
  // provider hiccup can't strand a user outside their own account.
  deliveryFailed Boolean   @default(false)
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@map("email_otp_challenges")
}

// "Remember this device for 30 days" — an opaque token in an httpOnly cookie
// (tokenHash persisted, same pattern as Session's refresh token) presented on
// a future login to skip the OTP challenge for that browser only.
model TrustedDevice {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  label      String? // e.g. "Chrome on macOS" — best-effort, for the user's own recognition
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("trusted_devices")
}

// ═══════════════════════════════════════════════════════════
// DATA ROOMS (engagements: CIRP case / liquidation / M&A project)
// ═══════════════════════════════════════════════════════════

model DataRoom {
  id                              String         @id @default(uuid())
  organisationId                  String
  name                            String
  type                            DataRoomType   @default(OTHER)
  caseNumber                      String?
  status                          DataRoomStatus @default(ACTIVE)
  startDate                       DateTime?
  endDate                         DateTime?
  storageLimitGb                  Int            @default(25)
  storageUsedBytes                BigInt         @default(0)
  // Highest storage-warning threshold (0/80/95/100) already emailed for —
  // crossing upward past this fires the next warning once; dropping back
  // below it (e.g. after deletions) resets it so a future re-crossing alerts again.
  highestStorageThresholdNotified Int            @default(0)
  // Watermark appearance — tokens: {{name}} {{email}} {{date}} {{time}} {{ip}}
  watermarkTemplate               String         @default("{{name}} | {{email}} | {{date}} | {{ip}} | CONFIDENTIAL")
  watermarkOpacity                Float          @default(0.25)
  watermarkPosition               String         @default("diagonal")
  // IP Allowlisting — if enabled, only IPs matching allowedIps CIDRs can access
  ipAllowlistEnabled              Boolean        @default(false)
  allowedIps                      String[]       @default([])
  // NDA Gate — members must accept NDA before viewing content
  ndaEnabled                      Boolean        @default(false)
  ndaText                         String?        @db.Text
  // Folder-level access control (Phase 3A). Defaults false for every
  // existing and new room -- when false, room membership continues to mean
  // "full access to every folder" exactly as before this feature existed;
  // FolderAccessService.resolve() short-circuits on this flag without
  // touching FolderAccessGrant at all. Only a room manager can turn this on
  // (see DataRoomsService.setFolderAccessRestricted()), and nothing in this
  // codebase ever sets it to true automatically.
  folderAccessRestricted          Boolean        @default(false)
  createdBy                       String
  createdAt                       DateTime       @default(now())
  updatedAt                       DateTime       @updatedAt
  deletedAt                       DateTime?

  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  members        DataRoomMember[]
  folders        Folder[]
  files          File[]
  auditLogs      AuditLog[]
  emailLogs      EmailLog[]
  ndaAcceptances NdaAcceptance[]
  questions      Question[]
  notifications  Notification[]

  @@index([organisationId, deletedAt])
  @@map("data_rooms")
}

// Phase 3A: one explicit folder-access grant for one user on one folder.
// Resolved with nearest-grant-boundary inheritance (see FolderAccessService)
// -- NOT "nearest ancestor where this user has a grant": the walk stops at
// the nearest ancestor that has ANY live grant row at all (a "grant
// boundary"), and that folder's own grant list is then authoritative for
// every descendant that doesn't have an even-closer boundary of its own.
// A user absent from the nearest boundary's grant list has NO access, even
// if a more distant ancestor would have granted them one -- this is how
// "explicit restriction on one branch" is expressed without a separate deny
// concept (see the Phase 3A completion report's worked examples).
//
// One row per (folderId, userId) forever, toggled via revokedAt -- same
// soft-state convention as DataRoomMember.removedAt, not multiple historical
// rows. Re-granting after a revoke updates this same row; the full grant/
// revoke history lives in AuditLog, not here.
//
// Deliberately carries no permission-level field: a grant means "this user
// can reach this folder" -- once reachable, the user's EXISTING room-level
// effectiveRole governs what they can do there (view/upload/delete/
// download), exactly as it does everywhere else today. DOWNLOAD_ORIGINAL in
// particular is never implied by a folder grant -- it stays the fully
// separate DataRoomMember.canDownloadOriginal check it already was.
// Phase 3A.1: userId and groupId are both nullable -- exactly one is set per
// row, enforced in FolderPermissionsService, never both. Postgres treats
// each NULL as distinct for uniqueness, so the two @@unique constraints
// below independently enforce "one row per (folder,user)" and "one row per
// (folder,group)" without interfering with each other -- no schema need for
// a separate GroupFolderAccessGrant table duplicating this same shape.
model FolderAccessGrant {
  id        String    @id @default(uuid())
  folderId  String
  userId    String?
  groupId   String?
  grantedBy String
  grantedAt DateTime  @default(now())
  revokedAt DateTime?
  revokedBy String?

  folder Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group  Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([folderId, userId])
  @@unique([folderId, groupId])
  @@index([folderId])
  @@index([userId])
  @@index([groupId])
  @@map("folder_access_grants")
}

// Organisation-scoped group of users, grantable on folders exactly like an
// individual user (FolderAccessGrant.groupId) -- the nearest-grant-boundary
// resolver treats a group grant identically to a user grant; see
// FolderAccessService's buildResolver() for exactly where group membership
// is folded into the same boundary/reachable-set computation, with zero
// change to the walk algorithm itself.
model Group {
  id             String   @id @default(uuid())
  organisationId String
  name           String
  // Deactivating (not deleting) a group immediately removes every member's
  // group-derived access on the next request -- nothing to separately
  // revoke per folder, same reasoning as DataRoomMember.removedAt.
  isActive       Boolean  @default(true)
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  members      GroupMember[]
  folderGrants FolderAccessGrant[]

  @@unique([organisationId, name])
  @@index([organisationId])
  @@map("groups")
}

// One row per (group, user) forever, toggled via removedAt -- same
// soft-state convention as DataRoomMember.removedAt and
// FolderAccessGrant.revokedAt, not multiple historical rows.
model GroupMember {
  id        String    @id @default(uuid())
  groupId   String
  userId    String
  addedBy   String
  addedAt   DateTime  @default(now())
  removedAt DateTime?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("group_members")
}

// Junction: a user's membership + optional role override within one data room.
model DataRoomMember {
  id                  String    @id @default(uuid())
  dataRoomId          String
  userId              String
  roleOverride        UserRole?
  // Which client legal entity this member represents in THIS room -- a
  // single room can span a corporate group with several related entities,
  // and the same person may represent a different one in a different room.
  clientOrganisation  String?
  notes               String?
  invitedBy           String?
  invitedAt           DateTime  @default(now())
  joinedAt            DateTime?
  removedAt           DateTime?
  // Explicit, per-member opt-in to bypass watermarking entirely and receive
  // the exact original uploaded binary -- deliberately NOT derived from role
  // or room-manager tier, and defaults false for every existing and new
  // member, so shipping this never silently grants it to anyone. A room
  // manager turns it on per member; SUPER_ADMIN bypasses this check the same
  // way it bypasses IP-allowlist/NDA elsewhere, everyone else (including
  // ORG_ADMIN) needs this flag set explicitly on their own membership row.
  canDownloadOriginal Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  dataRoom DataRoom @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dataRoomId, userId])
  @@map("data_room_members")
}

// ═══════════════════════════════════════════════════════════
// FOLDERS & FILES
// ═══════════════════════════════════════════════════════════

// Self-referencing tree. parentId null = root of the data room.
// path is materialised (e.g. "/Legal/Contracts") for fast breadcrumb/tree queries.
model Folder {
  id         String    @id @default(uuid())
  dataRoomId String
  parentId   String?
  name       String
  path       String
  depth      Int       @default(0)
  sortOrder  Int       @default(0)
  createdBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  dataRoom     DataRoom            @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  parent       Folder?             @relation("FolderTree", fields: [parentId], references: [id])
  children     Folder[]            @relation("FolderTree")
  files        File[]
  accessGrants FolderAccessGrant[]
  questions    Question[]

  @@index([dataRoomId, parentId])
  @@index([dataRoomId, path])
  @@map("folders")
}

// Database-backed folder template -- replaces the earlier hardcoded CIRP
// array. One row per DataRoomType that gets an auto-seeded structure;
// DataRoomsService.create() looks this up by type rather than branching on
// a hardcoded type check. Deactivating a template (isActive: false) stops
// it being offered for new rooms without deleting the historical record of
// what rooms created under it were actually seeded with.
model DataRoomTemplate {
  id           String       @id @default(uuid())
  dataRoomType DataRoomType @unique
  name         String
  description  String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  folders DataRoomTemplateFolder[]

  @@map("data_room_templates")
}

// One node in a template's folder tree. Self-referential, same shape as
// Folder itself, so seeding is a straightforward recursive copy rather than
// a format conversion.
model DataRoomTemplateFolder {
  id         String  @id @default(uuid())
  templateId String
  parentId   String?
  name       String
  sortOrder  Int     @default(0)

  template DataRoomTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  parent   DataRoomTemplateFolder?  @relation("TemplateFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children DataRoomTemplateFolder[] @relation("TemplateFolderTree")

  @@index([templateId, parentId])
  @@map("data_room_template_folders")
}

// File metadata. Binary content lives in storage (local disk for V1.0,
// behind IStorageService so S3/R2 can slot in later without touching this model).
// currentVersionId is nullable to break the circular FK — set after the first
// FileVersion is created.
model File {
  id               String    @id @default(uuid())
  dataRoomId       String
  folderId         String?
  name             String
  description      String?
  mimeType         String
  extension        String
  sizeBytes        BigInt    @default(0)
  currentVersionId String?   @unique
  uploadedBy       String
  isLocked         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  dataRoom        DataRoom           @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  folder          Folder?            @relation(fields: [folderId], references: [id])
  uploader        User               @relation("FileUploader", fields: [uploadedBy], references: [id])
  currentVersion  FileVersion?       @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions        FileVersion[]      @relation("FileVersions")
  watermarkEvents Watermark[]
  analyses        DocumentAnalysis[]

  @@index([dataRoomId, folderId])
  @@index([dataRoomId, name])
  @@index([dataRoomId, deletedAt])
  @@map("files")
}

// Immutable — a new row is inserted on every re-upload, never updated.
model FileVersion {
  id               String   @id @default(uuid())
  fileId           String
  versionNumber    Int
  storagePath      String
  sizeBytes        BigInt
  mimeType         String
  checksum         String
  uploadedBy       String
  comment          String?
  createdAt        DateTime @default(now())
  // Cached Office->PDF conversion (Word/Excel/PowerPoint only), populated on
  // first preview/download and reused after — set once, never invalidated,
  // since a given version's bytes never change.
  convertedPdfPath String?

  file            File        @relation("FileVersions", fields: [fileId], references: [id], onDelete: Cascade)
  currentForFile  File?       @relation("CurrentVersion")
  uploader        User        @relation("FileVersionUploader", fields: [uploadedBy], references: [id])
  watermarkEvents Watermark[]

  @@unique([fileId, versionNumber])
  @@index([fileId, createdAt])
  @@map("file_versions")
}

// ═══════════════════════════════════════════════════════════
// AUDIT TRAIL & WATERMARKING (append-only — see migration trigger
// added in the Audit Logs module; never call .update()/.delete() on these)
// ═══════════════════════════════════════════════════════════

// dataRoomId is nullable: account-level events (login, logout, invite) aren't
// scoped to any one data room. Resource-level events (file/folder ops) set it.
model AuditLog {
  id             String      @id @default(uuid())
  dataRoomId     String?
  userId         String?
  // Which organisation this action was taken in -- not part of the tamper
  // checksum (same reasoning as ipAddress/userAgent: supplementary context,
  // not identity-bearing content). Nullable: historical rows are backfilled
  // from the actor's org at the time; system events with no user stay null.
  organisationId String?
  action         AuditAction
  resourceType   String?
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  // SHA-256 of the row's logical content, computed at insert time — tamper detection
  checksum       String
  createdAt      DateTime    @default(now())

  dataRoom  DataRoom?  @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  user      User?      @relation(fields: [userId], references: [id])
  watermark Watermark?

  @@index([dataRoomId, createdAt])
  @@index([dataRoomId, action])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// One row per watermarked view/download — enables reverse lookup ("who
// downloaded this copy?") for leak investigations. Immutable like AuditLog.
model Watermark {
  id            String   @id @default(uuid())
  auditLogId    String   @unique
  fileId        String
  fileVersionId String
  userId        String?
  watermarkId   String   @unique
  elements      Json
  createdAt     DateTime @default(now())

  auditLog    AuditLog    @relation(fields: [auditLogId], references: [id], onDelete: Cascade)
  file        File        @relation(fields: [fileId], references: [id])
  fileVersion FileVersion @relation(fields: [fileVersionId], references: [id])
  user        User?       @relation(fields: [userId], references: [id])

  @@index([fileId, createdAt])
  @@map("watermarks")
}

// ═══════════════════════════════════════════════════════════
// PHASE 3B — AI-ASSISTED PDF EXTRACTIVE SUMMARISATION
//
// Tenant-scoping columns (dataRoomId/organisationId) live only on
// DocumentAnalysis, the top-level entity -- matching this schema's own
// convention (Question carries dataRoomId; Answer, one level down, does
// not, and reaches it via questionId). Every real access pattern starts
// from a file in a room, never "all sentences across a room" directly.
//
// SummarySentenceReference is the actual integrity mechanism, not just a
// convention: it has no text column at all. A ranking provider (AI or
// otherwise) can only ever supply a sentenceId; the worker can only ever
// write a row that foreign-keys to an ExtractedSentence that already
// exists from the verified extraction pass. A fabricated or altered
// sentence isn't a validation failure to catch here -- it's a row that
// cannot be constructed, because there is nowhere to put its text.
// ═══════════════════════════════════════════════════════════

enum DocumentAnalysisStatus {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_WARNINGS
  FAILED
  CANCELLED
}

model DocumentAnalysis {
  id               String                 @id @default(uuid())
  fileId           String
  fileVersionId    String
  dataRoomId       String
  organisationId   String
  status           DocumentAnalysisStatus @default(PENDING)
  // Increments on an explicit regeneration -- the row for a given
  // (fileId, fileVersionId) pair is never mutated into a new version in
  // place; a prior COMPLETED analysis stays exactly as it was.
  analysisVersion  Int                    @default(1)
  // FileVersion.checksum captured at the start of processing, and
  // re-verified (not re-derived) once extraction finishes -- see
  // checksumVerified below.
  originalChecksum String
  checksumVerified Boolean?
  // Safe, user-facing message only -- never a stack trace or raw error.
  errorMessage     String?
  requestedBy      String
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  file         File                @relation(fields: [fileId], references: [id], onDelete: Cascade)
  requester    User                @relation(fields: [requestedBy], references: [id])
  pages        ExtractedPage[]
  sentences    ExtractedSentence[]
  sections     SummarySection[]
  // Phase 3C: the Claude-backed synthesis run for this analysis, if the
  // feature was enabled when it ran. Optional and additive -- the Mock
  // provider's sections/sentenceRefs above are written unconditionally,
  // regardless of whether this relation is ever populated.
  aiSummaryRun AiSummaryRun?

  @@unique([fileId, fileVersionId, analysisVersion])
  @@index([dataRoomId])
  @@index([fileId, fileVersionId])
  @@map("document_analyses")
}

// Phase 3C: which pipeline actually produced a page's text. NATIVE_TEXT and
// UNAVAILABLE together reproduce exactly today's pre-Phase-3C behavior
// (isScannedOrImageOnly was the only signal); OCR/OCR_FAILED are new.
enum PageExtractionMethod {
  NATIVE_TEXT
  OCR
  OCR_FAILED
  UNAVAILABLE
}

model ExtractedPage {
  id                   String               @id @default(uuid())
  documentAnalysisId   String
  pageNumber           Int
  charCount            Int
  isScannedOrImageOnly Boolean              @default(false)
  // Phase 3C additions. extractionMethod defaults to NATIVE_TEXT for the
  // migration's sake, but a one-time data-fix sets historically-scanned
  // rows to UNAVAILABLE (see the migration.sql edit called out in the
  // Phase 3C plan) -- a freshly-processed page always gets its real value
  // written by the processor, never left at this default.
  extractionMethod     PageExtractionMethod @default(NATIVE_TEXT)
  ocrConfidence        Float?
  ocrLanguage          String?
  ocrDurationMs        Int?

  documentAnalysis DocumentAnalysis @relation(fields: [documentAnalysisId], references: [id], onDelete: Cascade)

  @@unique([documentAnalysisId, pageNumber])
  @@map("extracted_pages")
}

model ExtractedSentence {
  id                 String   @id @default(uuid())
  documentAnalysisId String
  pageNumber         Int
  sequenceNumber     Int
  // Exact, verbatim text as sliced from the source by byte offset -- never
  // edited, never reconstructed from a library's own text property.
  text               String
  // Lowercased/whitespace-collapsed, kept SEPARATE from `text` -- used only
  // for duplicate-sentence detection, never shown to a user and never the
  // thing matched against for fidelity verification.
  normalizedText     String
  createdAt          DateTime @default(now())

  documentAnalysis DocumentAnalysis           @relation(fields: [documentAnalysisId], references: [id], onDelete: Cascade)
  references       SummarySentenceReference[]
  // Phase 3C: citations from Claude-written statements pointing at this
  // exact, already-verified sentence -- see AiSummaryCitation below.
  aiCitations      AiSummaryCitation[]

  @@unique([documentAnalysisId, pageNumber, sequenceNumber])
  @@map("extracted_sentences")
}

enum SummarySectionType {
  EXECUTIVE_OVERVIEW
  BACKGROUND_FACTS
  PARTIES
  DATES_CHRONOLOGY
  FINANCIAL_FIGURES
  CLAIMS_LIABILITIES
  LEGAL_PROVISIONS
  PROCEEDINGS_ORDERS
  FINDINGS_DECISIONS
  RELIEF
  OTHER_MATERIAL
  // Phase 3C additions -- the Mock provider never emits these (same dead-
  // under-Mock situation BACKGROUND_FACTS was already in), but Claude's
  // analysis has no existing value that fits either without conflating two
  // categories the Phase 3C brief lists as distinct.
  RISKS_AND_OBSERVATIONS
  ACTION_ITEMS
}

model SummarySection {
  id                 String             @id @default(uuid())
  documentAnalysisId String
  sectionType        SummarySectionType
  displayOrder       Int

  documentAnalysis DocumentAnalysis           @relation(fields: [documentAnalysisId], references: [id], onDelete: Cascade)
  sentenceRefs     SummarySentenceReference[]

  @@unique([documentAnalysisId, sectionType])
  @@map("summary_sections")
}

model SummarySentenceReference {
  id                  String @id @default(uuid())
  summarySectionId    String
  // Required FK, no text column on this table at all -- see the section
  // header comment above.
  extractedSentenceId String
  rank                Int
  score               Float

  section  SummarySection    @relation(fields: [summarySectionId], references: [id], onDelete: Cascade)
  sentence ExtractedSentence @relation(fields: [extractedSentenceId], references: [id], onDelete: Cascade)

  @@unique([summarySectionId, extractedSentenceId])
  @@map("summary_sentence_references")
}

// ═══════════════════════════════════════════════════════════
// PHASE 3C — CLAUDE-BACKED SYNTHESIS (additive, parallel to the extractive
// architecture above, which stays completely unchanged and keeps running
// unconditionally). Unlike SummarySentenceReference, AiSummaryStatement
// carries Claude's OWN synthesized text, not a verbatim sentence -- the
// integrity guarantee here isn't "nowhere to put fabricated text" (that
// guarantee is structurally impossible once a provider can write prose) but
// "every factual claim in that prose is independently, mechanically checked
// against the exact text of the sentences it cites" (StatementVerification
// Service), with the result recorded, never assumed, on every statement.
// ═══════════════════════════════════════════════════════════

enum AiSummaryRunStatus {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_WARNINGS
  FAILED
  SKIPPED_LIMIT_REACHED
}

model AiSummaryRun {
  id                    String             @id @default(uuid())
  documentAnalysisId    String             @unique
  status                AiSummaryRunStatus @default(PENDING)
  provider              String             @default("ANTHROPIC")
  // The CLAUDE_SUMMARY_MODEL value read when this run started -- kept
  // distinct from modelUsed (below) since the configured model and the
  // model that actually answered are two different facts worth both having.
  modelRequested        String
  modelUsed             String?
  chunkCount            Int                @default(0)
  // Indexes (not IDs) of PageChunkBuilder's chunks already persisted --
  // what makes partial-chunk recovery real: a retried run skips any index
  // already present here instead of re-paying for completed work.
  completedChunkIndexes Int[]              @default([])
  inputTokens           Int                @default(0)
  outputTokens          Int                @default(0)
  // Money in micro-USD (1 USD = 1,000,000 units) -- mirrors Payment/
  // Invoice's integer-smallest-unit convention, at the finer precision
  // Claude's sub-cent-per-call pricing actually needs (a paise-sized unit
  // would round most individual calls to zero).
  estimatedCostMicroUsd Int                @default(0)
  actualCostMicroUsd    Int                @default(0)
  errorMessage          String?
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  documentAnalysis DocumentAnalysis     @relation(fields: [documentAnalysisId], references: [id], onDelete: Cascade)
  statements       AiSummaryStatement[]

  @@map("ai_summary_runs")
}

// Renamed from VERIFIED/PARTIALLY_VERIFIED/UNVERIFIED during the Phase 3C.1
// audit closure (zero rows existed at the time, so this was a free rename,
// not a data migration) to make room for CONFLICTING_SOURCE -- a statement
// whose OWN cited sources disagree with each other must never be reported
// as VERIFIED just because one of them happens to match; see
// StatementVerificationService's cross-citation conflict check.
enum StatementVerificationStatus {
  VERIFIED
  PARTIALLY_SUPPORTED
  UNSUPPORTED
  CONFLICTING_SOURCE
}

model AiSummaryStatement {
  id                  String                      @id @default(uuid())
  aiSummaryRunId      String
  sectionType         SummarySectionType
  displayOrder        Int
  // Claude's OWN synthesized wording -- NOT required to be a verbatim
  // substring of any source sentence. This is the one place in the whole
  // document-analysis feature where generated (not merely selected) text is
  // persisted; every such row's integrity rests entirely on
  // verificationStatus below, never on this column's own shape.
  statementText       String
  verificationStatus  StatementVerificationStatus @default(UNSUPPORTED)
  // {checkedTokens:[{type,value,matched,matchedSentenceId?}], ...} -- a
  // transparency record of what StatementVerificationService actually
  // checked, derived entirely from text already stored elsewhere in this
  // schema. Never a new confidence signal and never something a provider
  // supplies -- it is reconstructed by the backend's own verification pass.
  verificationDetails Json?
  createdAt           DateTime                    @default(now())

  run       AiSummaryRun        @relation(fields: [aiSummaryRunId], references: [id], onDelete: Cascade)
  citations AiSummaryCitation[]

  @@index([aiSummaryRunId, sectionType])
  @@map("ai_summary_statements")
}

model AiSummaryCitation {
  id                  String   @id @default(uuid())
  statementId         String
  // Required FK into the SAME ExtractedSentence table the extractive
  // pipeline already populates and verifies -- a citation that doesn't
  // resolve to a real row for this exact documentAnalysisId (or that wasn't
  // part of the specific chunk Claude was actually shown) is rejected by
  // StatementVerificationService before a row here is ever written.
  extractedSentenceId String
  citationOrder       Int
  createdAt           DateTime @default(now())

  statement AiSummaryStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  sentence  ExtractedSentence  @relation(fields: [extractedSentenceId], references: [id], onDelete: Cascade)

  @@unique([statementId, extractedSentenceId])
  @@index([extractedSentenceId])
  @@map("ai_summary_citations")
}

enum AiUsageStatus {
  SUCCEEDED
  FAILED
  RATE_LIMITED
  TIMEOUT
  // Call never made -- recorded for budget-block visibility and audit
  // completeness, always zero tokens/cost.
  BUDGET_BLOCKED
}

// One row per Claude call ATTEMPT (not per analysis) -- including failed,
// rate-limited, timed-out, and budget-blocked attempts, satisfying "usage
// accounting for failed and retried requests" directly. Deliberately
// carries no document text anywhere -- only IDs, model/token/cost numbers,
// and a status.
model AiUsageLedger {
  id                    String        @id @default(uuid())
  organisationId        String
  dataRoomId            String
  fileId                String
  documentAnalysisId    String
  // Null only for a BUDGET_BLOCKED row recorded before an AiSummaryRun
  // exists at all (the budget guard runs before the run row is created).
  aiSummaryRunId        String?
  // BullMQ job.id -- not always equal to documentAnalysisId; a retry uses a
  // distinct id (see DocumentAnalysisService.retryAnalysis).
  jobId                 String
  provider              String        @default("ANTHROPIC")
  model                 String
  inputTokens           Int           @default(0)
  outputTokens          Int           @default(0)
  estimatedCostMicroUsd Int
  // Null until the response returns usage -- in practice not null for long,
  // since the (non-Batch) Messages API returns usage synchronously in the
  // same response as the call itself.
  actualCostMicroUsd    Int?
  // Always USD -- Anthropic's own billing currency, unrelated to this
  // product's Payment/Invoice INR convention.
  currency              String        @default("USD")
  status                AiUsageStatus
  createdAt             DateTime      @default(now())

  @@index([organisationId, createdAt])
  @@index([dataRoomId, createdAt])
  @@index([documentAnalysisId])
  @@index([createdAt])
  @@map("ai_usage_ledger")
}

// ═══════════════════════════════════════════════════════════
// PERMISSIONS (granular override table — schema-ready; enforcement
// beyond role-based guards is a stretch goal, not required for V1.0)
// ═══════════════════════════════════════════════════════════

model Permission {
  id            String              @id @default(uuid())
  scopeType     PermissionScope
  scopeId       String
  principalType PermissionPrincipal
  principalId   String
  // { view, download, upload, delete, print }
  flags         Json
  createdBy     String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?

  @@index([scopeType, scopeId])
  @@index([principalType, principalId])
  @@map("permissions")
}

// ═══════════════════════════════════════════════════════════
// EMAIL ACTIVITY (Resend integration — every send attempt logged here,
// regardless of provider, for troubleshooting and the future reporting
// requirement)
// ═══════════════════════════════════════════════════════════

enum EmailStatus {
  SENT
  FAILED
  DELIVERED // webhook-confirmed; Resend only, nodemailer/dev never reaches this
  BOUNCED // webhook-confirmed; Resend only
}

enum EmailTemplate {
  USER_INVITATION
  DATA_ROOM_INVITATION
  PASSWORD_RESET
  WELCOME_EMAIL
  EMAIL_VERIFICATION // template built, no trigger wired yet
  ACCOUNT_CREATED // template built, no trigger wired yet
  STORAGE_WARNING_80
  STORAGE_CRITICAL_95
  STORAGE_FULL_100
  SUBSCRIPTION_ACTIVATED
  SUBSCRIPTION_RENEWAL_REMINDER
  SUBSCRIPTION_UPGRADE_CONFIRMATION
  SUBSCRIPTION_CANCELLED
  DOCUMENT_UPLOADED
  DEMO_REQUEST // internal notification: marketing-site demo form
  CALLBACK_REQUEST // internal notification: marketing-site callback form
  STORAGE_UPGRADE_REQUESTED // internal notification: org admin requests more storage
  MFA_OTP_CODE
  LOGIN_ALERT
  PASSWORD_CHANGED
  MFA_STATUS_CHANGED
  PAYMENT_FAILED
}

// userId/dataRoomId are both optional since not every email has either
// context (password reset has no data room; a future subscription email
// may have no single data room either). resentFromId links a resend
// attempt back to the original row it's resending, rather than adding a
// separate "RESENT" status that would collide with the real
// provider-reported terminal states.
model EmailLog {
  id                String        @id @default(uuid())
  template          EmailTemplate
  status            EmailStatus
  recipientEmail    String
  subject           String
  userId            String?
  dataRoomId        String?
  providerMessageId String?
  errorMessage      String?
  resentFromId      String?
  sentAt            DateTime      @default(now())
  deliveredAt       DateTime?
  bouncedAt         DateTime?

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  dataRoom DataRoom? @relation(fields: [dataRoomId], references: [id], onDelete: SetNull)

  @@index([providerMessageId])
  @@index([userId, sentAt])
  @@index([dataRoomId])
  @@map("email_logs")
}

// ═══════════════════════════════════════════════════════════
// SAAS BILLING (Subscription, Payment, Invoice)
// ═══════════════════════════════════════════════════════════

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

model Subscription {
  id                 String             @id @default(uuid())
  organisationId     String             @unique
  planSlug           String
  billingCycle       BillingCycle
  storageGb          Int
  status             SubscriptionStatus
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  payments     Payment[]
  invoices     Invoice[]

  @@map("subscriptions")
}

model Payment {
  id               String        @id @default(uuid())
  subscriptionId   String
  organisationId   String
  amountPaisa      Int
  currency         String        @default("INR")
  status           PaymentStatus
  gatewayOrderId   String?       @unique
  gatewayPaymentId String?       @unique
  gatewaySignature String?
  failureReason    String?
  metadata         Json?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invoice      Invoice?

  @@index([organisationId, createdAt])
  @@map("payments")
}

// Amounts stored in paise (1 INR = 100 paise) to avoid floating-point issues.
// Invoice number format: INV-YYYY-NNNNNN (year-scoped sequential number).
model Invoice {
  id                String        @id @default(uuid())
  subscriptionId    String
  organisationId    String
  paymentId         String?       @unique
  invoiceNumber     String        @unique
  amountPaisa       Int
  gstAmountPaisa    Int
  totalAmountPaisa  Int
  status            InvoiceStatus
  issuedAt          DateTime?
  paidAt            DateTime?
  lineItems         Json
  customerGstNumber String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  payment      Payment?     @relation(fields: [paymentId], references: [id])

  @@index([organisationId, createdAt])
  @@map("invoices")
}

// Idempotency ledger for inbound payment-gateway webhooks. Razorpay (and any
// future provider) retries webhook delivery on anything but a prompt 2xx, so
// the same event can arrive more than once -- this table is the dedup guard:
// insert-or-skip on (provider, externalId, eventType) before doing any real
// work. externalId is the gateway's own id for the underlying entity (e.g.
// a Razorpay payment or refund id), not our own Payment.id.
model WebhookEvent {
  id          String   @id @default(uuid())
  provider    String
  eventType   String
  externalId  String
  payload     Json
  processedAt DateTime @default(now())

  @@unique([provider, externalId, eventType])
  @@map("webhook_events")
}

// ═══════════════════════════════════════════════════════════
// ENTERPRISE FEATURES (Phase 2)
// ═══════════════════════════════════════════════════════════

// Immutable record of each user accepting a data room's NDA.
model NdaAcceptance {
  id         String   @id @default(uuid())
  dataRoomId String
  userId     String
  acceptedAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?

  dataRoom DataRoom @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dataRoomId, userId])
  @@index([dataRoomId, acceptedAt])
  @@map("nda_acceptances")
}

enum QuestionStatus {
  PENDING
  ANSWERED
  REJECTED
  WITHDRAWN
}

model Question {
  id         String         @id @default(uuid())
  dataRoomId String
  askedBy    String
  question   String         @db.Text
  status     QuestionStatus @default(PENDING)
  // Private questions are only visible to the asker + data room managers
  isPrivate  Boolean        @default(false)
  // Phase 3A.1: optional tag naming which folder this question concerns.
  // Null means a room-general question, not about any specific restricted
  // content -- same treatment as a root-level file with no folder: visible
  // per the existing room-membership/isPrivate rule alone, never gated by
  // folder-ACL. A non-null folderId additionally requires the viewer to be
  // able to reach that folder (see QnaService's folder-access check) --
  // every existing (pre-this-phase) question has folderId: null and is
  // therefore completely unaffected by this column's addition.
  folderId   String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?

  dataRoom DataRoom @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)
  asker    User     @relation("QuestionAsker", fields: [askedBy], references: [id])
  folder   Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  answers  Answer[]

  @@index([dataRoomId, status])
  @@index([dataRoomId, askedBy])
  @@index([folderId])
  @@map("questions")
}

model Answer {
  id         String    @id @default(uuid())
  questionId String
  answeredBy String
  answer     String    @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerer User     @relation("AnswerAuthor", fields: [answeredBy], references: [id])

  @@index([questionId, createdAt])
  @@map("answers")
}

// ═══════════════════════════════════════════════════════════
// NOTIFICATION CENTER (Phase 2)
// ═══════════════════════════════════════════════════════════

enum NotificationType {
  FILE_UPLOADED
  MEMBER_INVITED
  QUESTION_ASKED
  QUESTION_ANSWERED
  DATA_ROOM_UPDATED
  PERMISSION_CHANGED
  STORAGE_UPGRADE_REQUESTED
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  type       NotificationType
  dataRoomId String?
  title      String
  message    String
  isRead     Boolean          @default(false)
  metadata   Json?
  createdAt  DateTime         @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataRoom DataRoom? @relation(fields: [dataRoomId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ═══════════════════════════════════════════════════════════
// BUSINESS PROFILE (seller identity — single row, Super Admin editable)
// ═══════════════════════════════════════════════════════════

// One row (id = "default"). Source of truth for seller identity shown across
// the app, emails, and invoices. Seeded from packages/shared BUSINESS_PROFILE;
// when GST registration is obtained, set gstNumber here once and it flows
// everywhere. Kept as a table (not env) so Super Admin can edit at runtime.
model BusinessProfile {
  id           String   @id @default("default")
  businessName String
  tagline      String
  legalName    String
  pan          String
  gstNumber    String?
  address      String
  supportEmail String
  supportPhone String
  website      String
  updatedAt    DateTime @updatedAt

  @@map("business_profile")
}

// ═══════════════════════════════════════════════════════════
// COUPONS (discount codes applied at checkout)
// ═══════════════════════════════════════════════════════════

enum CouponType {
  PERCENT // value = whole percent, e.g. 20 => 20% off
  FIXED // value = flat discount in paise
}

enum CouponStatus {
  ACTIVE
  DISABLED
}

model Coupon {
  id               String       @id @default(uuid())
  code             String       @unique // stored uppercase
  type             CouponType
  value            Int
  minOrderPaisa    Int? // minimum order value to qualify
  maxDiscountPaisa Int? // cap on a PERCENT discount
  validFrom        DateTime?
  validUntil       DateTime?
  maxRedemptions   Int? // total across all customers
  perCustomerLimit Int? // per email
  applicablePlans  String[]     @default([]) // empty = all plans
  status           CouponStatus @default(ACTIVE)
  description      String?
  internalNotes    String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  redemptions CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id             String   @id @default(uuid())
  couponId       String
  organisationId String?
  email          String
  discountPaisa  Int
  createdAt      DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([email])
  @@map("coupon_redemptions")
}
